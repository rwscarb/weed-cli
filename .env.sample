# Copy this to .env and fill in what you need:
#   cp .env.sample .env
#
# docker-compose.node.yml (`make node`) reads a .env file here
# automatically -- that's the main thing this is for. The plain
# CLI/shell (weed.py, shell.py) and web_ui.py read these from the real
# process environment instead, nothing here auto-loads it for them; export
# what you need first, e.g.:
#   set -a && source .env && set +a && python3 weed.py discover

# Default discovery relay for the CLI/shell/web UI -- one or more
# comma-separated http(s):// URLs. Falls back to a local loopback relay
# (see `make discovery` / `relay` in the shell) if unset. `make node`
# (docker-compose.node.yml) ignores this exact default and instead
# starts its own local relay automatically, reachable at
# http://relay:9101 from inside that container -- leave WEED_RELAY unset
# there too unless you want to point it at different (e.g. public) infra.
WEED_RELAY=http://127.0.0.1:9101

# Default tunnel relay (tunnel_relay.py) for hosting behind NAT/CGNAT --
# [tls://]host:port. Unset means "no tunnel, rely on a directly
# reachable port instead."
#WEED_TUNNEL=tls://t.hak4.org:9199

# docker-compose.node.yml only: host directory bind-mounted at /share in
# the node container, for real .ott archives you want to host. Defaults
# to ./share (next to docker-compose.node.yml) if unset -- an absolute
# path here is a real path on *your* machine, not inside the container.
#WEED_SHARE_DIR=~/Movies

# discovery_relay.py only: where it persists published/unpublished
# events across restarts. Defaults to relay_events.jsonl next to the
# script itself; only worth setting explicitly for something like a
# mounted Fly Volume path.
#WEED_RELAY_DATA=/data/events.jsonl

# Set automatically inside Docker builds (see Dockerfile.node's
# GIT_COMMIT build arg, computed by `make node` via `git rev-parse`) --
# the version banner's commit hash, since a Docker image never has
# .git/ to read it from live. No reason to set this by hand outside
# Docker.
#WEED_GIT_COMMIT=
